generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitOfMeasure {
  MM
  CM
  M
  M2
  M3
  UNIDADE
  GRAMA
  KG
  ML
  LITRO
}

model Supplier {
  id        String             @id @default(uuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  materials MaterialSupplier[]

  @@map("suppliers")
}

model RawMaterial {
  id          String  @id @default(uuid())
  name        String
  description String?

  usageUnit        UnitOfMeasure // unidade usada no consumo (ex: CM)
  conversionFactor Decimal       @db.Decimal(12, 6) // quantas usageUnit existem em 1 purchaseUnit do fornecedor padrão

  stockQty      Decimal  @default(0) @db.Decimal(12, 4) // estoque atual em usageUnit
  minStockAlert Decimal? @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suppliers      MaterialSupplier[]
  productItems   ProductMaterial[]
  stockMovements StockMovement[]

  @@map("raw_materials")
}

model MaterialSupplier {
  id            String      @id @default(uuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])

  purchaseUnit  UnitOfMeasure // unidade em que é comprado desse fornecedor (ex: M)
  purchaseQty   Decimal       @db.Decimal(12, 4) // quantidade comprada nessa unidade (ex: 3 metros)
  purchasePrice Decimal       @db.Decimal(12, 2) // preço vigente pago a esse fornecedor

  isDefault Boolean @default(false) // fornecedor usado no cálculo de custo do produto

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory PriceHistory[]

  @@unique([rawMaterialId, supplierId])
  @@map("material_suppliers")
}

model PriceHistory {
  id                 String           @id @default(uuid())
  materialSupplierId String
  materialSupplier   MaterialSupplier @relation(fields: [materialSupplierId], references: [id], onDelete: Cascade)

  purchaseUnit  UnitOfMeasure
  purchaseQty   Decimal       @db.Decimal(12, 4)
  purchasePrice Decimal       @db.Decimal(12, 2)

  recordedAt DateTime @default(now())

  @@map("price_history")
}

model LaborRate {
  id         String   @id @default(uuid())
  name       String // ex: "Marceneiro Sênior"
  hourlyRate Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productLabors ProductLabor[]

  @@map("labor_rates")
}

model Product {
  id                String                @id @default(uuid())
  name              String
  description       String?
  marginPercent     Float                 @default(0)
  overheadPercent   Float                 @default(0)
  materials         ProductMaterial[]
  labors            ProductLabor[]
  kitItems          KitItem[]
  overheadItems     ProductOverheadItem[]
  costSnapshots     ProductCostSnapshot[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  productionRecords ProductionRecord[]

  @@map("products")
}

model ProductOverheadItem {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_overhead_items")
}

model ProductMaterial {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  quantityUsed Decimal @db.Decimal(12, 4) // quantidade usada, na usageUnit da matéria-prima
  wastePercent Decimal @default(0) @db.Decimal(6, 2) // percentual de perda/desperdício

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_materials")
}

model ProductLabor {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  laborRateId String
  laborRate   LaborRate @relation(fields: [laborRateId], references: [id])

  hoursSpent Decimal @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_labors")
}

model ProductCostSnapshot {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  materialsCost Decimal @db.Decimal(12, 2)
  laborCost     Decimal @db.Decimal(12, 2)
  overheadCost  Decimal @db.Decimal(12, 2)
  subtotalCost  Decimal @db.Decimal(12, 2)
  marginValue   Decimal @db.Decimal(12, 2)
  finalPrice    Decimal @db.Decimal(12, 2)

  breakdown Json // detalhamento completo em JSON
  createdAt DateTime @default(now())

  @@map("product_cost_snapshots")
}

enum ImageOwnerType {
  RAW_MATERIAL
  SUPPLIER
  PRODUCT
  KIT
}

model Image {
  id        String         @id @default(uuid())
  ownerType ImageOwnerType
  ownerId   String
  url       String
  filename  String
  createdAt DateTime       @default(now())

  @@index([ownerType, ownerId])
  @@map("images")
}

model Marketplace {
  id                 String   @id @default(uuid())
  name               String   @unique
  slug               String   @unique
  commissionPercent  Float
  commissionCapValue Float?
  fixedFeeValue      Float?
  lowValueFeeTiers   Json?
  isActive           Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("marketplaces")
}

model Kit {
  id              String    @id @default(uuid())
  name            String
  description     String?
  marginPercent   Float     @default(0)
  overheadPercent Float     @default(0)
  items           KitItem[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("kits")
}

model KitItem {
  id        String   @id @default(uuid())
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@map("kit_items")
}

enum StockMovementType {
  CONSUMPTION
  RESTOCK
  MANUAL_ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(uuid())
  rawMaterialId String
  rawMaterial   RawMaterial       @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 4) // positivo = entrada no estoque, negativo = saída
  note          String?

  productionRecordId String?
  productionRecord   ProductionRecord? @relation(fields: [productionRecordId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("stock_movements")
}

model ProductionRecord {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantityProduced Decimal @db.Decimal(12, 4)
  unitCost         Decimal @db.Decimal(12, 2)
  totalCost        Decimal @db.Decimal(12, 2)

  stockMovements StockMovement[]

  createdAt DateTime @default(now())

  @@map("production_records")
}
